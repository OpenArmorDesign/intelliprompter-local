OPENROUTER_API_KEY=
TYPESAFE_API_KEY=

# Local mode (intelliprompter-local): score with a decision model you run yourself, no key needed.
# LOCAL_URL is the model server's address and port, e.g. 192.168.1.50:11434. LOCAL_MODEL is the model name
# as that server knows it, e.g. nimble. LOCAL_API_KEY is only for servers started with an API key.
# When LOCAL_URL and LOCAL_MODEL are both set, the page starts in local mode. Both can also be entered on the page.
# The page also writes the address and model settings back to this file when you enter them there, so you never
# have to edit it by hand. It never writes API keys.
LOCAL_URL=
LOCAL_MODEL=
LOCAL_API_KEY=

# Speech to text on your own server (optional). Leave these empty to keep the browser's built-in speech
# recognition (the original behavior). STT_URL is the speech server's address and port, e.g. 192.168.1.50:5092.
# STT_MODEL is the model name the server expects (default whisper-1, which many servers accept for any model).
# STT_API_KEY is only for servers that require one. The speech server must offer the OpenAI-style route
# POST /v1/audio/transcriptions. See docs/SPEECH-TO-TEXT.md.
STT_URL=
STT_MODEL=
STT_API_KEY=
