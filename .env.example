OPENROUTER_API_KEY=
TYPESAFE_API_KEY=

# Local mode (intelliprompter-local): score with a decision model you run yourself, no key needed.
# LOCAL_URL is the model server's address and port, e.g. 192.168.1.50:11434. LOCAL_MODEL is the model name
# as that server knows it, e.g. nimble. LOCAL_API_KEY is only for servers started with an API key.
# When LOCAL_URL and LOCAL_MODEL are both set, the page starts in local mode. Both can also be entered on the page.
LOCAL_URL=
LOCAL_MODEL=
LOCAL_API_KEY=
